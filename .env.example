# Copy to .env (never commit .env). All Claude features are optional;
# without a key the dashboard runs fully locally with calculator results only.
ANTHROPIC_API_KEY=

# Model used for explanations (any current Claude model id).
CLAUDE_MODEL=claude-opus-5-5
# Effort for explanation requests: low | medium | high
CLAUDE_EFFORT=low
# Server-side refusal fallbacks ("default") or "off"
CLAUDE_FALLBACKS=default
CLAUDE_TIMEOUT_S=30
CLAUDE_MAX_RETRIES=2
CLAUDE_MIN_INTERVAL_S=8
CLAUDE_MAX_REQUESTS_PER_SESSION=60
# 1 = explain each new validated decision automatically (rate-limited + cached)
CLAUDE_AUTO_EXPLAIN=1
# 1 = allow sending a single ambiguous card crop to Claude on demand
CLAUDE_VISION_FALLBACK=0

# Local service
TABLE_ASSISTANT_PORT=8765
# TABLE_ASSISTANT_DATA=./backend/data
